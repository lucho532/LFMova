# Copiar este archivo a ".env" (en la raíz del repositorio) y completar los
# valores antes de ejecutar `docker compose up`. El archivo ".env" nunca debe
# versionarse (ver .gitignore).

POSTGRES_DB=lfmova
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Clave usada para firmar los JWT. Debe ser un valor largo y aleatorio,
# distinto entre entornos. Nunca reutilizar un valor de ejemplo en producción.
JWT_CLAVE_SECRETA=
JWT_EMISOR=LFMova
JWT_AUDIENCIA=LFMova
JWT_EXPIRACION_MINUTOS=60

# Origen desde el que el frontend (ejecutado por separado) consumirá la API.
CORS_ORIGEN_FRONTEND=http://localhost:5173
